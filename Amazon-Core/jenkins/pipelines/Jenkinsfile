pipeline {
    agent any

    stages {
        stage('Clone Project') {
            steps {
                echo 'Project checked out from SCM'
            }
        }

        stage('Check Tools') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
       }
    }
}
